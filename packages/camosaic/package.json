{
  "name": "camosaic",
  "version": "0.1.0",
  "description": "Camera-based shared canvas tracking for multiple physical screens",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minagishl/camosaic.git",
    "directory": "packages/camosaic"
  },
  "homepage": "https://github.com/minagishl/camosaic#readme",
  "bugs": "https://github.com/minagishl/camosaic/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup src/index.ts src/core/index.ts src/react/index.ts --format esm --dts --clean --external react --out-dir dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "react": "^19.1.1",
    "tsup": "^8.5.0"
  },
  "dependencies": {
    "js-aruco2": "^2.0.0"
  }
}
